# Copy to .env. It is untracked and survives `git reset --hard`, which is how each host
# keeps its own identity across deploys.

# --- The development host (dev.example.com) -------------------------------
# Serves the working tree live: app reloads, assets rebuild, edits are on the site as
# soon as they are saved. COMPOSE_FILE is what layers the overlay in.
SITE_ADDRESS=dev.example.com
WWW_ADDRESS=:8080
COMPOSE_PROJECT_NAME=whitelabel-dev
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# --- Production (example.com) ----------------------------------------------
# scripts/bootstrap.sh writes this, and deploy.yml maintains the last two lines. Never
# add COMPOSE_FILE here: production runs compose.yaml alone.
# SITE_ADDRESS=example.com
# WWW_ADDRESS=www.example.com
# COMPOSE_PROJECT_NAME=whitelabel
# APP_IMAGE=ghcr.io/<owner>/<repo>:<sha>

# --- A laptop, or CI, with no DNS ----------------------------------------------------
# SITE_ADDRESS=:80
# WWW_ADDRESS=:8080
